// Ninguém Tá Puro — modelo de dados
// Estratégia monetária: todos os valores em unidades menores inteiras (cêntimos) + moeda explícita.
// Dados de demonstração: coluna `isDemo` em todas as entidades de negócio; nunca misturados com dados reais.

generator client {
  provider        = "prisma-client-js"
  // Relações carregadas numa só consulta (JOIN) em vez de uma ida à base de dados por relação:
  // em produção cada ida custa a latência entre a Vercel e a BD.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  MZN
  BRL
  EUR
  USD
}

// ───────────────────────── Autenticação ─────────────────────────

enum UserRole {
  OWNER
  USER
}

enum AccountStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model User {
  id                     String                   @id @default(cuid())
  email                  String                   @unique
  name                   String
  passwordHash           String
  /// OWNER só é atribuído por migração/script no servidor (índice único parcial: no máximo um OWNER). Nunca pela API.
  role                   UserRole                 @default(USER)
  /// Estado de aprovação. Contas novas começam sempre pendentes (definido no servidor).
  status                 AccountStatus            @default(PENDING_APPROVAL)
  /// Suspensão separada da aprovação: desbanir devolve o acesso conforme o estado de aprovação.
  bannedAt               DateTime?
  banReason              String?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  lastLoginAt            DateTime?
  /// Preferência visual do painel: "system" | "light" | "dark" (não afeta checkouts públicos)
  themePreference        String                   @default("system")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  sessions               Session[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
  settings               Settings?
  products               Product[]
  checkouts              Checkout[]
  checkoutSessions       CheckoutSession[]
  funnels                Funnel[]
  funnelRuns             FunnelRun[]
  customers              Customer[]
  orders                 Order[]
  coupons                Coupon[]
  analyticsEvents        AnalyticsEvent[]
  integrations           IntegrationConfig[]
  metaPixels             MetaPixel[]
  refunds                Refund[]
  adminActions           AdminAuditLog[]          @relation("AdminActor")
  adminTargets           AdminAuditLog[]          @relation("AdminTarget")
  mediaAssets            MediaAsset[]
  passwordResets         PasswordResetToken[]
  revenueMilestones      RevenueMilestone[]
  credentialGrantsGiven  PaymentCredentialGrant[] @relation("GrantGrantor")
  credentialGrantsHeld   PaymentCredentialGrant[] @relation("GrantGrantee")
}

/// Registo das ações administrativas (aprovar, rejeitar, banir, desbanir).
model AdminAuditLog {
  id           String   @id @default(cuid())
  actorId      String
  actor        User     @relation("AdminActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUserId String
  target       User     @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  /// approve | reject | ban | unban
  action       String
  fromState    String?
  toState      String?
  reason       String?
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ───────────────────────── Catálogo ─────────────────────────

enum ProductType {
  DIGITAL
  COURSE
  EBOOK
  PDF
  SERVICE
  OTHER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

model Product {
  id              String             @id @default(cuid())
  name            String
  description     String             @db.Text
  imageUrl        String?
  type            ProductType
  category        String?
  status          ProductStatus      @default(DRAFT)
  salesPageUrl    String?
  supportEmail    String?
  /// Link externo de entrega (método EXTERNAL_LINK). Só é mostrado ao comprador depois do pagamento confirmado.
  deliveryUrl     String?
  /// Número de suporte WhatsApp do produto (formato internacional, só dígitos). Obrigatório para publicar.
  supportWhatsApp String?
  /// Mensagem inicial opcional da conversa de suporte
  supportMessage  String?
  /// Método de entrega escolhido pelo vendedor (obrigatório para publicar)
  deliveryMethod  DeliveryMethod?
  /// Ficheiro privado entregue ao comprador (método FILE). Sempre um ficheiro deste produto.
  deliveryFileId  String?
  deliveryFile    ProductFile?       @relation("ProductDeliveryFile", fields: [deliveryFileId], references: [id], onDelete: SetNull)
  /// Funil principal do produto (o que segue o fluxo de compra do checkout principal). Sempre da mesma conta.
  mainFunnelId    String?
  mainFunnel      Funnel?            @relation("ProductMainFunnel", fields: [mainFunnelId], references: [id], onDelete: SetNull)
  deliveryPage    DeliveryPage?
  metaPixels      MetaPixelProduct[]
  /// Conta dona deste registo (isolamento entre utilizadores)
  ownerId         String
  owner           User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  isDemo          Boolean            @default(false)
  archivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  offers          Offer[]
  checkouts       Checkout[]
  orderItems      OrderItem[]
  coupons         CouponProduct[]
  files           ProductFile[]      @relation("ProductFiles")
  funnels         Funnel[]

  @@index([isDemo, status])
  @@index([ownerId, isDemo, status])
  @@index([createdAt])
}

enum DeliveryMethod {
  /// O comprador é encaminhado para um link externo (área de membros, curso, download…)
  EXTERNAL_LINK
  /// Página de entrega criada na própria plataforma (/entrega/<token>/<produto>)
  INTERNAL_PAGE
  /// Ficheiro do produto (PDF) descarregado pelo acesso pessoal do comprador
  FILE
}

/// Página de entrega interna de um produto. Só é mostrada a quem tem uma encomenda paga que inclua o produto.
model DeliveryPage {
  id           String       @id @default(cuid())
  productId    String       @unique
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  title        String       @default("O seu produto está pronto")
  welcome      String       @default("") @db.Text
  instructions String       @default("") @db.Text
  /// Conteúdo apresentado na própria página (texto simples)
  bodyText     String       @default("") @db.Text
  buttonText   String       @default("ACEDER AO MEU PRODUTO")
  /// Link complementar (opcional)
  resourceUrl  String?
  /// Ficheiro privado entregue pelo botão principal (descarregado só pelo endpoint autenticado por token)
  fileId       String?
  file         ProductFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum BillingType {
  ONE_TIME
  INSTALLMENTS
  SUBSCRIPTION
}

/// Ofertas e preços de um produto. O produto tem sempre uma oferta `isDefault` (preço principal).
model Offer {
  id              String      @id @default(cuid())
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  priceCents      Int
  /// Preço "de" (riscado) para promoções. Apenas apresentação.
  compareAtCents  Int?
  currency        Currency
  billingType     BillingType @default(ONE_TIME)
  maxInstallments Int         @default(1)
  isDefault       Boolean     @default(false)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  checkouts       Checkout[]
  orderItems      OrderItem[]

  @@index([productId])
}

// ───────────────────────── Checkouts ─────────────────────────

model Checkout {
  id                 String            @id @default(cuid())
  /// Identificador público aleatório (não sequencial) usado em /checkout/<publicId>
  publicId           String            @unique
  /// Endereço legível e estável (ex.: /checkout/handwriting-heroes). Nunca muda ao renomear o produto.
  slug               String?           @unique
  /// Preenchido (= productId) apenas no checkout principal do produto: garante um único checkout principal por produto
  primaryProductId   String?           @unique
  name               String
  productId          String
  product            Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  offerId            String
  offer              Offer             @relation(fields: [offerId], references: [id], onDelete: Restrict)
  title              String
  description        String?           @db.Text
  imageUrl           String?
  buttonText         String            @default("Finalizar compra")
  primaryColor       String            @default("#C8F135")
  backgroundColor    String            @default("#0B0C0E")
  collectPhone       Boolean           @default(false)
  requirePhone       Boolean           @default(false)
  collectDocument    Boolean           @default(false)
  requireDocument    Boolean           @default(false)
  allowCoupons       Boolean           @default(true)
  successTitle       String            @default("Obrigado pela sua compra!")
  successMessage     String            @default("Receberá os detalhes de acesso por email.") @db.Text
  successRedirectUrl String?
  supportEmail       String?
  isActive           Boolean           @default(true)
  funnelId           String?
  funnel             Funnel?           @relation(fields: [funnelId], references: [id], onDelete: SetNull)
  /// Conta dona deste registo (isolamento entre utilizadores)
  ownerId            String
  owner              User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  isDemo             Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  orders             Order[]
  sessions           CheckoutSession[]
  design             CheckoutDesign?
  /// Página de obrigado personalizada (área Personalizar Checkout)
  thankYou           CheckoutThankYou?

  @@index([isDemo])
  @@index([ownerId, isDemo])
  @@index([productId])
}

/// Personalização visual do checkout (separada dos dados comerciais: preço, moeda, oferta e pagamento).
/// Página de obrigado personalizada de um checkout (rascunho/publicada). Só aparência e textos: os botões de
/// acesso seguem sempre a entrega real dos produtos pagos. Usada com e sem funil.
model CheckoutThankYou {
  id          String    @id @default(cuid())
  checkoutId  String    @unique
  checkout    Checkout  @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  draft       Json
  /// Versão apresentada aos compradores (null = página padrão)
  published   Json?
  publishedAt DateTime?
  version     Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CheckoutDesign {
  id             String    @id @default(cuid())
  checkoutId     String    @unique
  checkout       Checkout  @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  /// Versão em edição (não visível para os compradores)
  draft          Json
  /// Versão visível no checkout público (null = modelo padrão)
  published      Json?
  draftUpdatedAt DateTime  @default(now())
  publishedAt    DateTime?
  /// Incrementa a cada publicação
  version        Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CheckoutSession {
  id          String        @id @default(cuid())
  checkoutId  String
  checkout    Checkout      @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  /// Conta dona deste registo (isolamento entre utilizadores)
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  isDemo      Boolean       @default(false)
  status      SessionStatus @default(OPEN)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([checkoutId, createdAt])
  @@index([ownerId, isDemo, createdAt])
  @@index([isDemo, createdAt])
}

enum SessionStatus {
  OPEN
  SUBMITTED
  CONVERTED
}

// ───────────────────────── Funis ─────────────────────────

enum FunnelStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum FunnelStepType {
  START
  SALES_PAGE
  CHECKOUT
  PURCHASE_APPROVED
  UPSELL
  DOWNSELL
  ORDER_BUMP
  THANK_YOU
  END
}

model Funnel {
  id           String        @id @default(cuid())
  name         String
  description  String?
  status       FunnelStatus  @default(DRAFT)
  /// Conta dona deste registo (isolamento entre utilizadores)
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  isDemo       Boolean       @default(false)
  /// Produto inicial (funis criados pelo assistente). Null = funil avançado criado no editor visual.
  productId    String?
  product      Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  steps        FunnelStep[]
  edges        FunnelEdge[]
  checkouts    Checkout[]
  orders       Order[]
  runs         FunnelRun[]
  thankYouPage ThankYouPage?
  mainOf       Product[]     @relation("ProductMainFunnel")

  @@index([isDemo])
  @@index([ownerId, isDemo])
  @@index([productId])
}

/// Página de obrigado de um funil (aparência + destino do botão principal). Separada dos dados de pagamento.
model ThankYouPage {
  id        String       @id @default(cuid())
  funnelId  String       @unique
  funnel    Funnel       @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  /// Aparência e textos (ver src/lib/thank-you.ts)
  design    Json         @default("{}")
  /// Destino do botão: produto (PDF ou link) ou WhatsApp
  action    Json         @default("{}")
  /// Ficheiro PDF entregue quando o destino é "produto → PDF"
  fileId    String?
  file      ProductFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

/// Ficheiro privado de um produto (ex.: PDF). Guardado na base de dados, nunca exposto por URL público:
/// só é descarregado através do acesso pessoal de uma encomenda paga que inclua o produto.
model ProductFile {
  id            String         @id @default(cuid())
  productId     String
  product       Product        @relation("ProductFiles", fields: [productId], references: [id], onDelete: Cascade)
  filename      String
  mimeType      String
  sizeBytes     Int
  sha256        String
  data          Bytes
  createdAt     DateTime       @default(now())
  thankYouPages ThankYouPage[]
  deliveryPages DeliveryPage[]
  /// Produtos que entregam este ficheiro diretamente (método FILE)
  deliveredBy   Product[]      @relation("ProductDeliveryFile")

  @@index([productId])
}

model FunnelStep {
  id        String         @id @default(cuid())
  funnelId  String
  funnel    Funnel         @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  /// Identificador estável do nó dentro do funil (usado pelo editor e pelas ligações)
  key       String
  type      FunnelStepType
  label     String
  positionX Float
  positionY Float
  /// Configuração estruturada e validada (ver src/server/funnels/schema.ts)
  config    Json           @default("{}")

  @@unique([funnelId, key])
}

model FunnelEdge {
  id           String @id @default(cuid())
  funnelId     String
  funnel       Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  key          String
  sourceKey    String
  targetKey    String
  /// "next" | "accept" | "decline"
  sourceHandle String @default("next")

  @@unique([funnelId, key])
  @@index([funnelId])
}

/// Percurso de um comprador num funil (apenas simulado em modo de demonstração nesta fase).
model FunnelRun {
  id             String    @id
  funnelId       String
  funnel         Funnel    @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  /// Um percurso por encomenda (impede percursos duplicados para a mesma compra)
  orderId        String?   @unique
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  currentStepKey String
  /// Conta dona deste registo (isolamento entre utilizadores)
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  isDemo         Boolean   @default(true)
  history        Json      @default("[]")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([funnelId])
}

// ───────────────────────── Clientes e pedidos ─────────────────────────

model Customer {
  id        String   @id @default(cuid())
  email     String
  name      String
  phone     String?
  document  String?
  /// Conta dona deste registo (isolamento entre utilizadores)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@unique([ownerId, email, isDemo])
  @@index([isDemo, createdAt])
}

enum OrderStatus {
  PENDING
  APPROVED
  DECLINED
  REFUNDED
  CANCELED
}

enum OrderSource {
  CHECKOUT
  MANUAL_TEST
  DEMO
}

model Order {
  id              String                @id @default(cuid())
  /// Código legível e não sequencial, ex.: NTP-7K2M9QX4
  code            String                @unique
  customerId      String
  customer        Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  checkoutId      String?
  checkout        Checkout?             @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  funnelId        String?
  funnel          Funnel?               @relation(fields: [funnelId], references: [id], onDelete: SetNull)
  couponId        String?
  coupon          Coupon?               @relation(fields: [couponId], references: [id], onDelete: SetNull)
  status          OrderStatus           @default(PENDING)
  source          OrderSource
  currency        Currency
  subtotalCents   Int
  discountCents   Int                   @default(0)
  /// Valor bruto pago/a pagar = subtotal - desconto
  totalCents      Int
  /// Taxas efetivamente registadas (do processador). Nunca inventadas.
  feeCents        Int                   @default(0)
  /// total - taxas
  netCents        Int
  provider        String?
  externalRef     String?
  /// Método de pagamento escolhido (ex.: mpesa, emola) — apenas informativo
  paymentMethod   String?
  /// Token público aleatório para a página de estado do pagamento (não revela o código interno)
  publicToken     String?               @unique
  /// Chave de idempotência da submissão do checkout (impede encomendas duplicadas)
  idempotencyKey  String?               @unique
  /// Pago com credenciais de teste do fornecedor (sandbox): nunca conta como receita
  isTestPayment   Boolean               @default(false)
  notes           String?
  /// Conta dona deste registo (isolamento entre utilizadores)
  ownerId         String
  owner           User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  isDemo          Boolean               @default(false)
  /// Encomenda de upsell: aponta para a compra inicial (cada upsell é um pedido e pagamento próprios)
  parentOrderId   String?
  parentOrder     Order?                @relation("OrderUpsells", fields: [parentOrderId], references: [id], onDelete: Restrict)
  upsellOrders    Order[]               @relation("OrderUpsells")
  /// Etapa do funil que originou esta encomenda (upsell)
  funnelStepKey   String?
  approvedAt      DateTime?
  refundedAt      DateTime?
  canceledAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  items           OrderItem[]
  funnelRuns      FunnelRun[]
  paymentEvents   PaymentEvent[]
  payments        Payment[]
  auditLogs       OrderAuditLog[]
  delivery        Delivery?
  metaEvents      MetaEvent[]
  trackingContext OrderTrackingContext?
  refunds         Refund[]

  @@index([isDemo, status, createdAt])
  @@index([ownerId, isDemo, status, createdAt])
  @@index([customerId])
  @@index([checkoutId])
  @@index([parentOrderId])
}

enum OrderItemKind {
  MAIN
  ORDER_BUMP
  UPSELL
  DOWNSELL
}

model OrderItem {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  offerId        String?
  offer          Offer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)
  kind           OrderItemKind @default(MAIN)
  description    String
  unitPriceCents Int
  quantity       Int           @default(1)
  totalCents     Int

  @@index([orderId])
  @@index([productId])
}

// ───────────────────────── Cupons ─────────────────────────

enum DiscountType {
  PERCENT
  FIXED
}

model Coupon {
  id             String          @id @default(cuid())
  code           String
  description    String?
  type           DiscountType
  /// Percentagem inteira 1..100 quando type = PERCENT
  percentOff     Int?
  /// Valor fixo em cêntimos quando type = FIXED
  amountOffCents Int?
  /// Moeda obrigatória para descontos fixos
  currency       Currency?
  appliesToAll   Boolean         @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  maxUses        Int?
  usesCount      Int             @default(0)
  isActive       Boolean         @default(true)
  /// Conta dona deste registo (isolamento entre utilizadores)
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  isDemo         Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  products       CouponProduct[]
  orders         Order[]

  @@unique([ownerId, code, isDemo])
}

model CouponProduct {
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
}

// ───────────────────────── Analytics ─────────────────────────

model AnalyticsEvent {
  id         String   @id @default(cuid())
  type       String
  /// Conta dona deste registo (isolamento entre utilizadores)
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  isDemo     Boolean  @default(false)
  checkoutId String?
  funnelId   String?
  orderId    String?
  sessionId  String?
  stepKey    String?
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([isDemo, type, createdAt])
  @@index([ownerId, isDemo, type, createdAt])
  @@index([funnelId])
}

// ───────────────────────── Configurações e integrações ─────────────────────────

/// Configurações de cada conta (nome do negócio, moeda, fuso, modo de demonstração).
model Settings {
  id              String   @id @default(cuid())
  /// Conta dona destas configurações (uma linha por utilizador)
  ownerId         String?  @unique
  owner           User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  businessName    String   @default("Ninguém Tá Puro")
  logoUrl         String?
  ownerName       String?
  ownerEmail      String?
  supportEmail    String?
  defaultCurrency Currency @default(MZN)
  locale          String   @default("pt-MZ")
  timezone        String   @default("Africa/Maputo")
  /// Quando ativo, toda a aplicação mostra e cria apenas dados de demonstração
  demoMode        Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  ERROR
  DISABLED
}

enum IntegrationEnvironment {
  SANDBOX
  PRODUCTION
}

/// Integração de pagamento de UMA conta (uma linha por conta e fornecedor). Nunca partilhada entre contas.
model IntegrationConfig {
  id            String                 @id @default(cuid())
  ownerId       String
  owner         User                   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  provider      String
  status        IntegrationStatus      @default(NOT_CONFIGURED)
  environment   IntegrationEnvironment @default(SANDBOX)
  /// Apenas configuração pública/não secreta (ex.: IDs de carteira).
  publicConfig  Json                   @default("{}")
  /// Gateway disponível para NOVOS pagamentos. Desativar nunca apaga credenciais nem bloqueia confirmações.
  enabled       Boolean                @default(true)
  /// Credenciais introduzidas na aba Integrações, cifradas (AES-256-GCM, INTEGRATIONS_ENCRYPTION_KEY). Nunca em texto simples.
  secretConfig  String?
  /// Último teste de ligação bem-sucedido
  verifiedAt    DateTime?
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([ownerId, provider])
}

model IntegrationLog {
  id        String   @id @default(cuid())
  /// Conta a que o registo diz respeito (null: evento sem conta identificável)
  ownerId   String?
  provider  String
  level     String
  message   String
  createdAt DateTime @default(now())

  @@index([provider, createdAt])
  @@index([ownerId, createdAt])
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  REJECTED
  FAILED
}

/// Eventos de pagamento recebidos por webhook (futuro). Idempotência por (provider, externalEventId).
model PaymentEvent {
  id              String             @id @default(cuid())
  provider        String
  externalEventId String
  type            String
  signatureValid  Boolean
  status          PaymentEventStatus @default(RECEIVED)
  payload         Json
  orderId         String?
  order           Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// Conta dona da encomenda (definida depois de a assinatura ser validada com as credenciais dessa conta)
  ownerId         String?
  error           String?
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?

  @@unique([provider, externalEventId])
}

// ───────────────────────── Pagamentos reais (fornecedor externo) ─────────────────────────

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  CANCELED
  EXPIRED
}

/// Tentativa de pagamento junto de um fornecedor. Uma encomenda pode ter várias tentativas.
model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String
  method            String?
  /// Telefone mascarado (ex.: 84•••••67) — o número completo não é guardado aqui
  phoneMasked       String?
  amountCents       Int
  currency          Currency
  status            PaymentStatus @default(CREATED)
  /// Identificador/referência devolvido pelo fornecedor
  externalId        String?
  /// Estado bruto devolvido pelo fornecedor (auditoria)
  rawStatus         String?
  /// Página de pagamento alojada pelo fornecedor (ex.: payment_url da EPay)
  redirectUrl       String?
  /// "test" ou "live", conforme a chave usada
  environment       String?
  /// Justificativa apresentada (ex.: "Saldo insuficiente na carteira do cliente")
  failureReason     String?
  /// Resultado normalizado (src/server/payments/outcome.ts): CUSTOMER_CANCELLED, INSUFFICIENT_FUNDS, WRONG_PIN, TIMEOUT, GATEWAY_ERROR, NOT_STARTED, UNKNOWN
  failureCode       String?
  /// Motivo exatamente como o gateway o devolveu (auditoria)
  gatewayMessage    String?
  idempotencyKey    String        @unique
  /// Conta cujas credenciais do gateway foram usadas neste pagamento, quando NÃO é a dona da encomenda
  /// (credenciais partilhadas pelo administrador). null = credenciais da conta dona da encomenda.
  credentialOwnerId String?
  lastCheckedAt     DateTime?
  confirmedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([provider, externalId])
  @@index([orderId])
  @@index([status])
}

/// Registo de auditoria de todas as alterações de estado de encomendas.
model OrderAuditLog {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  /// ex.: "admin:<userId>", "webhook:epay", "status-check:epay", "checkout", "system"
  actor      String
  reason     String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

/// Acesso ao produto digital — criado uma única vez, só após pagamento confirmado.
model Delivery {
  id           String    @id @default(cuid())
  orderId      String    @unique
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  token        String    @unique
  accessCount  Int       @default(0)
  lastAccessAt DateTime?
  createdAt    DateTime  @default(now())
}

// ───────────────────────── Reembolsos ─────────────────────────

/// Reembolso registado de uma encomenda paga (parcial ou total). A plataforma não devolve dinheiro por si:
/// regista o reembolso feito no gateway (ou simulado em modo demo). A soma nunca excede o total da encomenda.
model Refund {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCents Int
  currency    Currency
  reason      String?
  /// ex.: "admin:<userId>"
  actor       String
  /// Conta dona deste registo (isolamento entre utilizadores)
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([isDemo, createdAt])
  @@index([ownerId, isDemo, createdAt])
}

// ───────────────────────── Notificações ─────────────────────────

enum NotificationType {
  SALE_CONFIRMED
  PAYMENT_PENDING
  PAYMENT_FAILED
  REFUND_CONFIRMED
  DAILY_SUMMARY
  TEST
  /// Alertas da conta (ex.: pedido de remoção de uma integração partilhada)
  ACCOUNT_ALERT
}

/// Notificação interna (canal "painel"). O push é outro canal: PushDelivery aponta para aqui.
/// eventKey + userId é único: o mesmo evento de pagamento nunca gera duas notificações para a mesma pessoa.
model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  /// ex.: "sale:<orderId>", "refund:<refundId>", "daily:2026-10-13", "test:<random>"
  eventKey   String
  title      String
  body       String
  /// Caminho interno a abrir (ex.: /pedidos/<id>)
  url        String?
  orderId    String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  deliveries PushDelivery[]

  @@unique([userId, eventKey])
  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushEnabled  Boolean  @default(true)
  sales        Boolean  @default(true)
  pending      Boolean  @default(true)
  failed       Boolean  @default(true)
  refunds      Boolean  @default(true)
  dailySummary Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

/// Dispositivo subscrito (Web Push). As chaves são públicas do navegador; o endpoint é secreto por natureza.
model PushSubscription {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String         @unique
  p256dh        String
  auth          String
  /// Chave pública VAPID com que foi criada (mudança de chaves invalida a subscrição)
  vapidKey      String
  deviceLabel   String
  userAgent     String?
  createdAt     DateTime       @default(now())
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?
  failureCount  Int            @default(0)
  /// Revogada pelo utilizador, pelo serviço de push (404/410) ou por mudança de chaves
  revokedAt     DateTime?
  revokedReason String?
  deliveries    PushDelivery[]

  @@index([userId, revokedAt])
}

enum PushDeliveryStatus {
  PENDING
  SENT
  FAILED
  GONE
}

/// Fila persistente de envios push (outbox). Tentativas limitadas com espera crescente.
/// SENT = aceite pelo serviço de push; receivedAt = o service worker do dispositivo confirmou a receção.
model PushDelivery {
  id             String             @id @default(cuid())
  notificationId String
  notification   Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   PushSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  status         PushDeliveryStatus @default(PENDING)
  attempts       Int                @default(0)
  nextAttemptAt  DateTime           @default(now())
  lastStatusCode Int?
  lastError      String?
  sentAt         DateTime?
  /// Segredo aleatório incluído no conteúdo cifrado: só o dispositivo o conhece para confirmar a receção
  receiptToken   String
  receivedAt     DateTime?
  createdAt      DateTime           @default(now())

  @@unique([notificationId, subscriptionId])
  @@index([status, nextAttemptAt])
}

/// Chaves VAPID geradas automaticamente (se não forem definidas no ambiente). Privada cifrada (secret-box).
model PushConfig {
  id            String   @id @default("default")
  publicKey     String
  privateKeyEnc String
  createdAt     DateTime @default(now())
}

/// Execuções únicas de tarefas (ex.: "daily-summary:2026-10-13") — evita repetir o resumo diário.
model JobRun {
  key       String   @id
  createdAt DateTime @default(now())
}

/// Biblioteca de imagens de cada conta (usadas no editor visual do checkout).
/// Servidas publicamente por /api/public/media/<id> (são mostradas nos checkouts públicos);
/// só a conta dona pode listar, usar no seu design ou apagar.
model MediaAsset {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  filename  String
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?
  sha256    String
  data      Bytes
  createdAt DateTime @default(now())

  @@unique([ownerId, sha256])
  @@index([ownerId, createdAt])
}

/// Pedido de redefinição de palavra-passe: só o hash do token é guardado; uso único e validade curta.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ───────────────────────── Facebook Pixel / API de Conversões (Meta) ─────────────────────────

/// Pixel Meta de uma conta. O token da API de Conversões fica cifrado (AES-256-GCM, secret-box) e nunca sai do servidor.
model MetaPixel {
  id            String             @id @default(cuid())
  ownerId       String
  owner         User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  /// ID numérico do Pixel (público)
  pixelId       String
  /// Token de acesso cifrado
  tokenEnc      String
  /// Últimos 4 caracteres do token (para o utilizador reconhecer qual está guardado)
  tokenHint     String
  /// Código de eventos de teste do Events Manager (opcional): só com ele os pagamentos de teste são enviados
  testEventCode String?
  enabled       Boolean            @default(true)
  lastSentAt    DateTime?
  lastError     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  products      MetaPixelProduct[]
  events        MetaEvent[]

  @@unique([ownerId, pixelId])
  @@index([ownerId])
}

/// Produtos cujas vendas confirmadas são enviadas a este Pixel (desde `createdAt`: vendas anteriores nunca são enviadas).
model MetaPixelProduct {
  id          String    @id @default(cuid())
  metaPixelId String
  metaPixel   MetaPixel @relation(fields: [metaPixelId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([metaPixelId, productId])
  @@index([productId])
}

enum MetaEventStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Evento Purchase de uma encomenda paga para um Pixel. Único por (Pixel, encomenda): nunca há duas compras para a
/// mesma transação; o mesmo `eventId` é reutilizado em todas as tentativas (desduplicação também do lado da Meta).
model MetaEvent {
  id             String          @id @default(cuid())
  ownerId        String
  metaPixelId    String
  metaPixel      MetaPixel       @relation(fields: [metaPixelId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventId        String
  status         MetaEventStatus @default(PENDING)
  attempts       Int             @default(0)
  nextAttemptAt  DateTime        @default(now())
  lockedUntil    DateTime?
  sentAt         DateTime?
  lastError      String?
  eventsReceived Int?
  fbtraceId      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([metaPixelId, orderId])
  @@index([status, nextAttemptAt])
  @@index([ownerId, createdAt])
}

/// Contexto técnico da compra para a API de Conversões (não pessoal): navegador e clique do anúncio (fbclid).
model OrderTrackingContext {
  orderId   String   @id
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userAgent String?
  /// Parâmetro fbc no formato oficial fb.1.<ms>.<fbclid>, quando o comprador chegou por um anúncio
  fbc       String?
  sourceUrl String?
  createdAt DateTime @default(now())
}

/// Metas de faturamento já celebradas no Dashboard (uma linha por conta e meta; nunca repetida).
/// Só regista a celebração: o faturamento é sempre calculado a partir dos pedidos aprovados.
model RevenueMilestone {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Valor da meta em cêntimos de MZN (ex.: 1000000 = 10.000 MZN)
  amountCents  Int
  celebratedAt DateTime @default(now())

  @@unique([userId, amountCents])
}

enum CredentialGrantStatus {
  ACTIVE
  REVOKED
}

/// Autorização dada pelo administrador (conta proprietária) para um utilizador usar as credenciais de UM gateway
/// do administrador nos seus próprios produtos. As credenciais nunca saem do servidor; a venda continua do utilizador.
/// No máximo uma autorização ATIVA por utilizador e gateway (índice único parcial na migração).
model PaymentCredentialGrant {
  id                 String                @id @default(cuid())
  grantorId          String
  grantor            User                  @relation("GrantGrantor", fields: [grantorId], references: [id], onDelete: Cascade)
  granteeId          String
  grantee            User                  @relation("GrantGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  /// "epay" ou "e2payments"
  provider           String
  status             CredentialGrantStatus @default(ACTIVE)
  grantedAt          DateTime              @default(now())
  revokedAt          DateTime?
  /// Pedido de remoção feito pelo utilizador autorizado (não revoga sozinho)
  removalRequestedAt DateTime?
  updatedAt          DateTime              @updatedAt

  @@index([granteeId, provider, status])
  @@index([grantorId, status])
}
