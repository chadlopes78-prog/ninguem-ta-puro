# Ligação PostgreSQL (obrigatória)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ntp?schema=public"

# URL pública da aplicação (usado para gerar links de checkout absolutos)
APP_URL="http://localhost:3000"

# Ferramentas de demonstração (seed/limpeza pela interface). Em produção mantenha "false".
DEMO_TOOLS_ENABLED="true"

# Pagamentos: nenhum processador real está integrado nesta fase.
# Segredos de webhook futuros serão definidos aqui, por exemplo:
# PAYMENTS_WEBHOOK_SECRET_<PROVIDER>="..."
