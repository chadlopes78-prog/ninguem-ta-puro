# ─────────────────────────────────────────────────────────────────────────────
# Ninguém Tá Puro — variáveis de ambiente (exemplo SEM valores reais)
# Copie para .env (desenvolvimento) ou defina-as no painel de variáveis secretas
# do alojamento. Nunca faça commit de ficheiros .env com valores reais.
# ─────────────────────────────────────────────────────────────────────────────

# Ligação PostgreSQL (obrigatória)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ntp?schema=public"

# URL público da aplicação, usado para o URL de retorno e o endpoint de notificações.
# Em produção tem de ser HTTPS (ex.: https://loja.exemplo.co.mz)
APP_BASE_URL="http://localhost:3000"

# Ferramentas de demonstração (gerar/limpar dados fictícios). Em produção: "false".
DEMO_TOOLS_ENABLED="false"

# ── EPay (Moçambique, MZN) ── apenas no servidor; NUNCA usar o prefixo NEXT_PUBLIC_
# Chave secreta da loja: painel EPay → Integrações → API → Chaves de API.
#   sk_test_…  ambiente de teste (sandbox, sem dinheiro real)
#   sk_live_…  produção (dinheiro real; exige empresa verificada e APP_BASE_URL em HTTPS)
# Os avisos de pagamento chegam a  <APP_BASE_URL>/api/webhooks/epay  (assinados com esta chave).
EPAY_SECRET_KEY=""

# ── E2Payments (Moçambique, MZN) ── opcional; apenas no servidor; NUNCA usar o prefixo NEXT_PUBLIC_
# Duas formas de configurar (a primeira tem prioridade):
#  a) Variáveis abaixo — painel e2payments.explicador.co.mz → Credenciais / Carteiras (ID sem o "#").
#  b) Aba Integrações da plataforma (recomendado) — as credenciais ficam cifradas na BD e podem ser alteradas no site.
# Depois de configurado, ative o gateway na aba Integrações (o teste de ligação tem de passar).
E2PAYMENTS_CLIENT_ID=""
E2PAYMENTS_CLIENT_SECRET=""
E2PAYMENTS_MPESA_WALLET_ID=""
E2PAYMENTS_EMOLA_WALLET_ID=""

# Opcional: chave dedicada para cifrar credenciais introduzidas na aba Integrações (AES-256-GCM).
# Sem ela, usa-se uma chave derivada de DATABASE_URL. Ex.: openssl rand -base64 32.
INTEGRATIONS_ENCRYPTION_KEY=""

# ── Notificações push (Web Push / PWA) ── opcional; apenas no servidor
# Sem estas variáveis, a plataforma gera um par de chaves VAPID na primeira utilização e guarda-o na base de dados
# (chave privada cifrada). Defina-as só se quiser fixar as chaves (ex.: npx web-push generate-vapid-keys).
# ATENÇÃO: mudar as chaves invalida os dispositivos já subscritos (têm de ativar de novo).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto do remetente das notificações (mailto: ou https://). Por omissão: o endereço do site ou o email de suporte.
VAPID_SUBJECT=""

# ── Tarefa diária (Vercel Cron → /api/cron/notifications) ── opcional
# Gera o resumo diário e reenvia notificações push pendentes. A Vercel envia "Authorization: Bearer <CRON_SECRET>".
# Sem CRON_SECRET o cron fica desativado e as mesmas tarefas correm quando o painel é aberto. Mínimo 16 caracteres.
CRON_SECRET=""

# Email (opcional) — recuperação da palavra-passe via API da Resend. Sem estas variáveis, o proprietário
# gera o link de redefinição em Administração. Definir só no servidor (Vercel), nunca no repositório.
RESEND_API_KEY=""
EMAIL_FROM=""

# Pagar API (https://pagar.co.mz/docs/ai-integration.md) — credenciais da CONTA PROPRIETÁRIA (opcional).
# Outras contas guardam as suas na aba Integrações (cifradas). Nunca coloque valores reais no Git.
# Webhook a configurar na app da Pagar: https://<o-seu-domínio>/api/webhooks/pagar
PAGAR_API_BASE_URL="https://api.pagar.co.mz/api/v1"
PAGAR_API_KEY=""
PAGAR_SIGNING_SECRET=""
PAGAR_WEBHOOK_SECRET=""
# Opcional: credenciais de produção (modo real). Também podem ser guardadas em Integrações → Pagar.
PAGAR_LIVE_API_KEY=""
PAGAR_LIVE_SIGNING_SECRET=""
PAGAR_LIVE_WEBHOOK_SECRET=""
