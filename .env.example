# ─────────────────────────────────────────────────────────────────────────────
# Ninguém Tá Puro — variáveis de ambiente (exemplo SEM valores reais)
# Copie para .env (desenvolvimento) ou defina-as no painel de variáveis secretas
# do alojamento. Nunca faça commit de ficheiros .env com valores reais.
# ─────────────────────────────────────────────────────────────────────────────

# Ligação PostgreSQL (obrigatória)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ntp?schema=public"

# URL público da aplicação, usado para o URL de retorno e o endpoint de notificações.
# Em produção tem de ser HTTPS (ex.: https://loja.exemplo.co.mz)
APP_BASE_URL="http://localhost:3000"

# Ferramentas de demonstração (gerar/limpar dados fictícios). Em produção: "false".
DEMO_TOOLS_ENABLED="false"

# ── EPay (Moçambique, MZN) ── apenas no servidor; NUNCA usar o prefixo NEXT_PUBLIC_
# Chave secreta da loja: painel EPay → Integrações → API → Chaves de API.
#   sk_test_…  ambiente de teste (sandbox, sem dinheiro real)
#   sk_live_…  produção (dinheiro real; exige empresa verificada e APP_BASE_URL em HTTPS)
# Os avisos de pagamento chegam a  <APP_BASE_URL>/api/webhooks/epay  (assinados com esta chave).
EPAY_SECRET_KEY=""
